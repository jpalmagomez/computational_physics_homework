\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces The Wien displacement equation written in terms of the dimensionless variable $x=hc/(\lambda k_BT)$ (left) and wavelength $\lambda $ (right). The nonzero root, $x\approx 4.962$, identifies the maximum of the Planck spectrum. Since $x$ is constant at this maximum, $\lambda _{\max }T=hc/(k_Bx)=\mathrm  {constant}$, giving Wien's displacement law, $\lambda _{\max }=b/T$.}}{7}{figure.caption.12}\protected@file@percent }
\newlabel{fig:wien_roots}{{2}{7}{The Wien displacement equation written in terms of the dimensionless variable $x=hc/(\lambda k_BT)$ (left) and wavelength $\lambda $ (right). The nonzero root, $x\approx 4.962$, identifies the maximum of the Planck spectrum. Since $x$ is constant at this maximum, $\lambda _{\max }T=hc/(k_Bx)=\mathrm {constant}$, giving Wien's displacement law, $\lambda _{\max }=b/T$}{figure.caption.12}{}}
\newlabel{fig:wien_roots@cref}{{[figure][2][]2}{[1][6][]7}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Planck radiation spectrum for a blackbody at $T=10{,}000\,\mathrm  {K}$. The dashed vertical line marks $\lambda _{\max }\approx 2.898\times 10^{-7}\,\mathrm  {m}$, obtained from the binary-search solution $x\approx 4.965114$.}}{8}{figure.caption.14}\protected@file@percent }
\newlabel{fig:wien_displacement_law}{{3}{8}{Planck radiation spectrum for a blackbody at $T=10{,}000\,\mathrm {K}$. The dashed vertical line marks $\lambda _{\max }\approx 2.898\times 10^{-7}\,\mathrm {m}$, obtained from the binary-search solution $x\approx 4.965114$}{figure.caption.14}{}}
\newlabel{fig:wien_displacement_law@cref}{{[figure][3][]3}{[1][7][]8}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Gradient descent applied to $f(x,y)=(x-2)^2+(y-2)^2$. The points show the path from the initial position toward the known minimum at $(2,2)$.}}{9}{figure.caption.17}\protected@file@percent }
\newlabel{fig:gradient_descent_test}{{4}{9}{Gradient descent applied to $f(x,y)=(x-2)^2+(y-2)^2$. The points show the path from the initial position toward the known minimum at $(2,2)$}{figure.caption.17}{}}
\newlabel{fig:gradient_descent_test@cref}{{[figure][4][]4}{[1][8][]9}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces The value of $\chi ^2$ as a function of gradient descent iteration. The flattening at late iterations indicates convergence to the minimum.}}{10}{figure.caption.18}\protected@file@percent }
\newlabel{fig:chi2_convergence}{{5}{10}{The value of $\chi ^2$ as a function of gradient descent iteration. The flattening at late iterations indicates convergence to the minimum}{figure.caption.18}{}}
\newlabel{fig:chi2_convergence@cref}{{[figure][5][]5}{[1][9][]10}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces The COSMOS stellar mass function and the best fit Schechter function obtained using gradient descent. The model reproduces both the low mass behavior and the high mass exponential cut off.}}{10}{figure.caption.19}\protected@file@percent }
\newlabel{fig:schechter_fit}{{6}{10}{The COSMOS stellar mass function and the best fit Schechter function obtained using gradient descent. The model reproduces both the low mass behavior and the high mass exponential cut off}{figure.caption.19}{}}
\newlabel{fig:schechter_fit@cref}{{[figure][6][]6}{[1][9][]10}{}{}{}}
