\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces The solution to the equation $x = 1 - e^{-cx}$ as a function of the parameter $c$. The solution exhibits a phase transition at $c=1$, where the system transitions from a regime of $x=0$ to a regime of $x\neq  0$. This is an example of a percolation phase transition in physics and an epidemic threshold in mathematical epidemiology.}}{3}{figure.caption.5}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:phase_transition}{{1}{3}{The solution to the equation $x = 1 - e^{-cx}$ as a function of the parameter $c$. The solution exhibits a phase transition at $c=1$, where the system transitions from a regime of $x=0$ to a regime of $x\neq 0$. This is an example of a percolation phase transition in physics and an epidemic threshold in mathematical epidemiology}{figure.caption.5}{}}
\newlabel{fig:phase_transition@cref}{{[figure][1][]1}{[1][3][]3}{}{}{}}
