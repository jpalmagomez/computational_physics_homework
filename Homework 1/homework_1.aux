\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Relative error $\epsilon $ as a function of step size $h$ for the forward-, central-, and extrapolated-difference methods for $f(x)=\cos (x)$ and $g(x)=e^x$ at $x=0.1$ and $x=10$.}}{5}{figure.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Relative error in the small-$h$ roundoff-dominated regime. The fitted slopes are close to $\epsilon \propto h^{-1}$ for the forward-, central-, and extrapolated-difference methods.}}{7}{figure.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Relative error in the truncation error dominated regime. The forward and central methods scale approximately as $h$ and $h^2$, while successive Richardson extrapolations approach $h^4$, $h^6$, and $h^8$.}}{8}{figure.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Relative integration error $\epsilon $ as a function of the number of bins $N$ for the midpoint, trapezoidal, and Simpson's rules. The fitted truncation-error scalings are approximately $N^{-2}$ for the midpoint and trapezoidal rules and $N^{-4}$ for Simpson's rule. At large $N$, roundoff error limits further improvement.}}{9}{figure.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Matter power spectrum $P(k)$ and comparison between the linear and cubic-spline interpolation methods.}}{9}{figure.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Correlation function obtained using cubic-spline and linear interpolation of the matter power spectrum, together with their fractional difference. Both methods locate the BAO peak at approximately $105.64$ Mpc$/h$, while giving slightly different values of $\xi (r)$.}}{11}{figure.6}\protected@file@percent }
